  "private": true,
  "description": "RTS-MK1 — Classic Command & Conquer / Dune 2000 Multiplayer & Skirmish RTS (https://rts-mk1.orbital8.cloud)",
  "scripts": {
    "dev": "next dev -p 4300 -H 0.0.0.0",
